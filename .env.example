APP_NAME=FiveBucket
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
CURL_CA_BUNDLE=
SSL_CERT_FILE=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=public
FIVEBUCKET_STORAGE_DISK=public
FIVEBUCKET_PUBLIC_BASE_URL="${APP_URL}/storage"
FIVEBUCKET_PRESIGNED_TTL_MINUTES=15
FIVEBUCKET_OVERAGE_PRICE_CENTS_PER_GB=10
FIVEBUCKET_LOGS_DRIVER=database
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_LOGS_TABLE=fivebucket_logs
CLICKHOUSE_LOGS_TTL_DAYS=90
CLICKHOUSE_TIMEOUT=10
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_GROWTH_10GB=
STRIPE_PRICE_SCALE_100GB=

# Self-hosted realtime via soketi. This uses Laravel's Pusher-compatible driver,
# but does not send data to Pusher.com.
PUSHER_APP_ID=fivebucket
PUSHER_APP_KEY=fivebucket
PUSHER_APP_SECRET=change_me_soketi
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
SOKETI_DEFAULT_APP_ID=fivebucket
SOKETI_DEFAULT_APP_KEY=fivebucket
SOKETI_DEFAULT_APP_SECRET=change_me_soketi

FIVEBUCKET_WEBSOCKET_HOST=127.0.0.1
FIVEBUCKET_WEBSOCKET_PORT=6001
FIVEBUCKET_WEBSOCKET_SCHEME=http
