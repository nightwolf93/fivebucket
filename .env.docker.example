FIVEBUCKET_ENV_FILE=.env.production
HTTP_PORT=8080

APP_NAME=FiveBucket
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://fivebucket.example.com

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

RUN_MIGRATIONS=true
RUN_SEEDERS=true
RUN_CLICKHOUSE_MIGRATIONS=true
WAIT_FOR_SERVICES=true
LARAVEL_CONFIG_CACHE=true

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fivebucket
DB_USERNAME=fivebucket
DB_PASSWORD=change_me_db

MYSQL_DATABASE=fivebucket
MYSQL_USER=fivebucket
MYSQL_PASSWORD=change_me_db
MYSQL_ROOT_PASSWORD=change_me_root

BROADCAST_DRIVER=pusher
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=r2
FIVEBUCKET_STORAGE_DISK=r2
FIVEBUCKET_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
FIVEBUCKET_PRESIGNED_TTL_MINUTES=15
FIVEBUCKET_OVERAGE_PRICE_CENTS_PER_GB=0

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET=fivem
R2_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_USE_PATH_STYLE_ENDPOINT=false

FIVEBUCKET_LOGS_DRIVER=clickhouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_LOGS_TABLE=fivebucket_logs
CLICKHOUSE_LOGS_TTL_DAYS=90
CLICKHOUSE_TIMEOUT=10

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@fivebucket.example.com
MAIL_FROM_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FREE=
STRIPE_PRICE_GROWTH_10GB=
STRIPE_PRICE_SCALE_100GB=

# Self-hosted realtime via soketi. The app talks to the soketi container;
# browsers use the current domain through the Docker nginx /app websocket proxy.
PUSHER_APP_ID=fivebucket
PUSHER_APP_KEY=fivebucket
PUSHER_APP_SECRET=change_me_soketi
PUSHER_HOST=soketi
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1
SOKETI_DEFAULT_APP_ID=fivebucket
SOKETI_DEFAULT_APP_KEY=fivebucket
SOKETI_DEFAULT_APP_SECRET=change_me_soketi

FIVEBUCKET_WEBSOCKET_HOST=
FIVEBUCKET_WEBSOCKET_PORT=
FIVEBUCKET_WEBSOCKET_SCHEME=
